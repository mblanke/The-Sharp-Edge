{
  "version": 1,
  "function": "merge_lines",
  "note": "Adding a second recipe must ADD to a line, never replace it.",
  "tolerance": 0.001,
  "cases": [
    {
      "id": "same-ingredient-and-unit-adds",
      "args": {
        "lines": [
          {
            "name": "sweet Hungarian paprika",
            "amount": 3,
            "unit": "tbsp",
            "recipe": "goulash"
          },
          {
            "name": "sweet Hungarian paprika",
            "amount": 2,
            "unit": "tbsp",
            "recipe": "rub"
          }
        ]
      },
      "expect": [
        {
          "name": "sweet Hungarian paprika",
          "amount": 5,
          "unit": "tbsp",
          "display": "5 tbsp",
          "to_taste": false,
          "recipes": [
            "goulash",
            "rub"
          ],
          "check_gluten": true,
          "aisle": "Herbs & spices"
        }
      ]
    },
    {
      "id": "preparation-is-ignored-when-matching",
      "args": {
        "lines": [
          {
            "name": "beef chuck, cut into 1-inch cubes",
            "amount": 2,
            "unit": "lb",
            "recipe": "goulash"
          },
          {
            "name": "beef chuck, trimmed",
            "amount": 1,
            "unit": "lb",
            "recipe": "stew"
          }
        ]
      },
      "expect": [
        {
          "name": "beef chuck, cut into 1-inch cubes",
          "amount": 3,
          "unit": "lb",
          "display": "3 lb",
          "to_taste": false,
          "recipes": [
            "goulash",
            "stew"
          ],
          "check_gluten": false,
          "aisle": "Meat & fish"
        }
      ]
    },
