# Copy to .env and adjust. Never commit .env.

# Postgres
POSTGRES_USER=sharpedge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sharpedge

# Public base URL the QR codes point at (Tailscale hostname or LAN address)
BASE_URL=http://localhost:3010

# URL the browser uses to reach the API (Tailscale/LAN address of this box)
PUBLIC_API_URL=http://localhost:8010

# Bearer token for write/admin routes — generate something long and random
API_TOKEN=change-me-long-random

# Atlas RAG stack — retrieval/embedding delegated (CLAUDE.md §9)
# Corpus drop folder: \\Olympus_NAS\Media\References\Cooking (auto-ingested every 6 h)
# ON ATLAS use the container names below: rag-api and llm-router sit on the external
# ai-stack network, and reaching them via the host's Tailscale IP times out from
# inside a container (the docker bridge has no route back to tailscale0).
# Off Atlas, use http://100.110.190.10:8099 and http://100.110.190.10:4000/v1.
RAG_API_URL=http://rag-api:8099
RAG_SOURCE_FOLDER=Cooking

# LiteLLM router on Atlas; 'cluster' load-balances the two GB10s (Wile + RoadRunner)
LLM_ROUTER_URL=http://llm-router:4000/v1
LLM_ROUTER_KEY=
CHAT_MODEL_ALIAS=cluster

# Read-only mount of the Cooking shelf for the /library book list.
# LIBRARY_HOST_DIR is the path on the host; LIBRARY_DIR is where it lands in the
# container. Leave LIBRARY_DIR empty to skip the book list entirely.
LIBRARY_HOST_DIR=/mnt/media/References/Cooking
LIBRARY_DIR=/mnt/references/Cooking

# Docker network the Atlas ai-stack created (rag-api, llm-router, qdrant…)
AI_STACK_NETWORK=ai-stack_ai

# Optional cloud tier — never receives corpus chunks (private tier, CLAUDE.md §9)
ANTHROPIC_API_KEY=
