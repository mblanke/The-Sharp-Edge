# Copy to .env and adjust. Never commit .env.

# Postgres
POSTGRES_USER=sharpedge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sharpedge

# Public base URL the QR codes point at (Tailscale hostname or LAN address)
BASE_URL=http://localhost:3000

# URL the browser uses to reach the API (Tailscale/LAN address of this box)
PUBLIC_API_URL=http://localhost:8000

# Bearer token for write/admin routes — generate something long and random
API_TOKEN=change-me-long-random

# Ollama on the host
OLLAMA_URL=http://host.docker.internal:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.1:8b

# Optional cloud tier (public-tier chunks only — see CLAUDE.md §9)
ANTHROPIC_API_KEY=
